  "private": true,
  "description": "An explorable 3D world that teaches how the Five Safes TES weave performs federated analysis across Trusted Research Environments.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
